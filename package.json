{
  "name": "devhatch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n build,server \"vite build --watch --config apps/web/vite.config.ts\" \"cargo run -p devhatch-server\"",
    "start": "cargo run -p devhatch-server --release",
    "typecheck": "tsc -b apps/web/tsconfig.json",
    "build": "tsc -b apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "lint": "oxlint apps/web/src apps/web/vite.config.ts",
    "preview": "npm start"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
